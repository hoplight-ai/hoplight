{
  "name": "hoplight-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-no-drafts-public.mjs",
    "build": "next build",
    "check:drafts": "node scripts/check-no-drafts-public.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test scripts/intake-ratelimit.test.mjs scripts/check-no-drafts-public.test.mjs",
    "verify": "bash scripts/verify.sh",
    "check:preview": "node scripts/check-preview-metadata.mjs",
    "check:claims": "node scripts/check-claims-and-palette.mjs",
    "tokens:build": "node scripts/build-brand-tokens.mjs",
    "tokens:check": "node scripts/build-brand-tokens.mjs --check",
    "palette:retire": "node scripts/retire-old-palette.mjs",
    "gallery:pull": "node scripts/pull-gallery.mjs",
    "screenshots:rayli": "node scripts/convert-rayli-shots.mjs",
    "portfolio:header": "node scripts/add-portfolio-header.mjs",
    "portfolio:metadata": "node scripts/add-portfolio-metadata.mjs",
    "portfolio:thumbs": "node scripts/optimize-portfolio-thumbs.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "next": "^16.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "sharp": "^0.35.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.8.3",
    "us-atlas": "^3.0.1"
  }
}
